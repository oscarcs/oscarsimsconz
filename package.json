{
    "name": "oscarsimsconz",
    "type": "module",
    "scripts": {
        "dev": "node scripts/dev.mjs",
        "client": "vite --mode client",
        "build": "$npm_execpath run version && vite build --mode client && cp -f ./dist/.vite/manifest.json ./src/lib/manifest.json && vite build",
        "preview": "wrangler pages dev dist",
        "deploy": "$npm_execpath run build && wrangler pages deploy dist",
        "version": "echo \"export default `date +'%s'`\" > ./src/config/build_time.ts && echo \"export default true\" > ./src/config/is_prod.ts",
        "typecheck": "tsc --noEmit"
    },
    "dependencies": {
        "@hono/react-renderer": "^1.0.1",
        "@types/three": "^0.186.0",
        "hono": "^4.13.13",
        "lucide-react": "^1.59.0",
        "qrcode": "^1.5.4",
        "react": "^19.3.1",
        "react-dom": "^19.3.1",
        "react-share": "^6.1.0",
        "tailwind-merge": "^3.7.0",
        "tailwindcss-animate": "^1.0.7",
        "three": "^0.186.1"
    },
    "devDependencies": {
        "@cloudflare/workers-types": "^5.20261019.1",
        "@hono/vite-cloudflare-pages": "^0.4.3",
        "@hono/vite-dev-server": "^0.26.1",
        "@tailwindcss/postcss": "^4.3.3",
        "@tailwindcss/typography": "^0.5.20",
        "@types/node": "^22.20.5",
        "@types/qrcode": "^1.5.6",
        "@types/react": "^19.3.0",
        "@types/react-dom": "^19.3.0",
        "@types/remarkable": "^2.0.8",
        "postcss": "^8.5.31",
        "tailwindcss": "^4.3.3",
        "vite": "^8.3.4",
        "wrangler": "^4.151.1",
        "typescript": "^7.0.2"
    },
    "overrides": {
        "@tailwindcss/typography": {
            "postcss-selector-parser": "^7.1.6"
        }
    }
}
